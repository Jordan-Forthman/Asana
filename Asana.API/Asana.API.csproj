<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference the project rather than a DLL under bin/Debug. The previous
      HintPath only resolved if Asana.Library happened to have been built
      already, and bin/ is not in source control, so a fresh clone failed to
      compile with 53 errors about missing ToDo and Project types.
    -->
    <ProjectReference Include="..\Asana.Library\Asana.Library.csproj" />
  </ItemGroup>

</Project>
